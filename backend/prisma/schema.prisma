generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 Int      @id @default(autoincrement())
  companyName        String
  ownerName          String?
  phone              String?
  email              String?
  address            String?
  timezone           String?  @default("America/New_York")
  plan               String   @default("basic")
  status             String   @default("active")
  supabaseUserId     String?  @unique
  defaultWorkspaceId Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  customers             Customer[]
  cleaners              Cleaner[]
  jobs                  Job[]
  teams                 Team[]
  cleanerAvailabilities CleanerAvailability[]
  companyUsers          CompanyUser[]

  // 新增：公司级设置相关
  workspaceSettings      WorkspaceSettings[]
  workspaceBusinessHours WorkspaceBusinessHour[]
  workspaceTaxProfiles   WorkspaceTaxProfile[]

  workspaces       Workspace[] @relation("CompanyWorkspaces")
  defaultWorkspace Workspace?  @relation("CompanyDefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)

  @@index([plan])
  @@index([status])
  @@index([email])
}

model Workspace {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  slug        String?
  isActive    Boolean  @default(true)
  source      String?
  externalRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company             Company   @relation("CompanyWorkspaces", fields: [companyId], references: [id], onDelete: Cascade)
  defaultForCompanies Company[] @relation("CompanyDefaultWorkspace")

  customers             Customer[]
  cleaners              Cleaner[]
  jobs                  Job[]
  teams                 Team[]
  cleanerAvailabilities CleanerAvailability[]
  companyUsers          CompanyUser[]

  // 新增：workspace 级设置相关
  settings      WorkspaceSettings?
  businessHours WorkspaceBusinessHour[]
  taxProfile    WorkspaceTaxProfile?

  @@index([companyId])
  @@index([slug])
  @@index([isActive])
  @@index([source])
  @@index([externalRef])
}

model CompanyUser {
  id             Int       @id @default(autoincrement())
  companyId      Int
  workspaceId    Int?
  supabaseUserId String?   @unique
  email          String
  fullName       String?
  role           String    @default("owner")
  status         String    @default("active")
  source         String?
  externalRef    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  lastLoginAt    DateTime?

  // 新增字段
  invitedAt       DateTime?
  acceptedAt      DateTime?
  avatarUrl       String?
  phone           String?
  permissionsJson Json?
  isPrimaryOwner  Boolean   @default(false)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([workspaceId])
  @@index([role])
  @@index([status])
}

model Customer {
  id          Int     @id @default(autoincrement())
  companyId   Int
  workspaceId Int?
  name        String
  phone       String?
  address     String?
  notes       String?

  // 原有新增字段
  email       String?
  companyName String?
  leadSource  String?
  street1     String?
  street2     String?
  city        String?
  province    String?
  postalCode  String?
  country     String?

  // 补充字段
  title                 String?
  firstName             String?
  lastName              String?
  role                  String?
  state                 String?
  billingSameAsProperty Boolean?  @default(true)
  billingStreet1        String?
  billingStreet2        String?
  billingCity           String?
  billingState          String?
  billingPostalCode     String?
  billingCountry        String?
  tags                  Json?
  isActive              Boolean   @default(true)
  isArchived            Boolean   @default(false)
  archivedAt            DateTime?
  deletedAt             DateTime?

  source      String?
  externalRef String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  jobs      Job[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([email])
  @@index([companyName])
  @@index([leadSource])
  @@index([source])
  @@index([externalRef])
  @@index([isActive])
  @@index([isArchived])
}

model Team {
  id          Int      @id @default(autoincrement())
  companyId   Int
  workspaceId Int?
  name        String
  leaderName  String?
  color       String?
  isActive    Boolean  @default(true)
  source      String?
  externalRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // 补充字段
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  cleaners  Cleaner[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([isActive])
  @@index([source])
  @@index([externalRef])
  @@index([isArchived])
}

model Cleaner {
  id          Int     @id @default(autoincrement())
  companyId   Int
  workspaceId Int?
  name        String
  phone       String?
  status      String  @default("active")
  team        String? // 保留，兼容你当前前端/后端
  teamId      Int?
  notes       String?

  // 原有新增字段
  email         String?
  avatarUrl     String?
  streetAddress String?
  city          String?
  province      String?
  postalCode    String?
  country       String?
  labourCost    Float?
  role          String? @default("Cleaner")

  // 补充字段
  employmentType      String?
  hourlyRate          Float?
  defaultStartTime    String?
  defaultEndTime      String?
  maxJobsPerDay       Int?
  serviceArea         String?
  color               String?
  isVisibleOnSchedule Boolean   @default(true)
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  deletedAt           DateTime?

  source      String?
  externalRef String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace      Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  teamRef        Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  jobs           Job[]
  availabilities CleanerAvailability[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([teamId])
  @@index([status])
  @@index([email])
  @@index([role])
  @@index([source])
  @@index([externalRef])
  @@index([isVisibleOnSchedule])
  @@index([isArchived])
}

model CleanerAvailability {
  id          Int      @id @default(autoincrement())
  companyId   Int
  workspaceId Int?
  cleanerId   Int
  date        DateTime
  startTime   String?
  endTime     String?
  isOff       Boolean  @default(false)
  notes       String?
  createdBy   String?
  source      String?
  externalRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  cleaner   Cleaner    @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, date])
  @@index([companyId])
  @@index([workspaceId])
  @@index([cleanerId])
  @@index([date])
  @@index([source])
  @@index([externalRef])
}

model Job {
  id          Int      @id @default(autoincrement())
  companyId   Int
  workspaceId Int?
  customerId  Int
  cleanerId   Int?
  serviceDate DateTime
  serviceTime String?
  serviceType String?
  address     String?
  notes       String?
  status      String   @default("pending")

  // 原有新增字段
  title        String?
  endDate      DateTime?
  endTime      String?
  instructions String?
  anytime      Boolean   @default(false)

  // 补充字段：排班 / 时长
  durationMinutes Int?

  // 补充字段：财务
  price          Float?
  subtotal       Float?
  discountAmount Float?
  taxAmount      Float?
  total          Float?
  paidAmount     Float?
  balanceDue     Float?
  paymentStatus  String?
  paymentMethod  String?
  invoiceNumber  String?

  // 补充字段：软删除 / 归档
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  orderNo     String?
  source      String?
  externalRef String?
  createdBy   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  assignedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cleaner   Cleaner?   @relation(fields: [cleanerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([workspaceId])
  @@index([customerId])
  @@index([cleanerId])
  @@index([serviceDate])
  @@index([status])
  @@index([orderNo])
  @@index([source])
  @@index([externalRef])
  @@index([invoiceNumber])
  @@index([paymentStatus])
  @@index([isArchived])
}

model WorkspaceSettings {
  id          Int @id @default(autoincrement())
  companyId   Int
  workspaceId Int @unique

  companyName String?
  website     String?
  email       String?
  phone       String?

  street1 String?
  street2 String?
  city    String?
  state   String?
  zipCode String?
  country String?

  timezone          String?
  dateFormat        String?
  timeFormat        String?
  firstDayOfWeek    String?
  showBusinessHours Boolean @default(true)

  logoUrl          String?
  brandColor       String?
  secondaryColor   String?
  currency         String?
  language         String?
  bookingEnabled   Boolean @default(false)
  publicBookingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workspaceId])
}

model WorkspaceBusinessHour {
  id          Int @id @default(autoincrement())
  companyId   Int
  workspaceId Int

  dayOfWeek Int
  isOpen    Boolean @default(false)
  startTime String?
  endTime   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dayOfWeek])
  @@index([companyId])
  @@index([workspaceId])
  @@index([dayOfWeek])
}

model WorkspaceTaxProfile {
  id          Int @id @default(autoincrement())
  companyId   Int
  workspaceId Int @unique

  taxName   String?
  taxNumber String?
  taxRate   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workspaceId])
}
